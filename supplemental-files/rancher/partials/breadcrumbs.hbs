<nav class="breadcrumbs" aria-label="breadcrumbs">
<ul>
    <li>
  {{! same version root as the product link: keeps /latest/ or /v0.7.0/ from the address bar and avoids the site root, which has no index page }}
  <a class="home-link-dsc" href="{{versionRootPath page}}" title="SUSE Documentation Home" aria-label="SUSE Documentation Home"></a>
    </li>
    <li>
      {{! component version root, relative so the entry point is preserved: /latest/ stays /latest/ }}
      <a href="{{versionRootPath page}}" title="{{projData 'title' this page.attributes.project-data}}" aria-label="SUSE Documentation - {{projData 'title' this page.attributes.project-data}}">
        {{{projData 'title' this page.attributes.project-data}}}
      </a>
    </li>
    {{#if page.breadcrumbs.[0]}}
      <li>
        {{#if (and page.breadcrumbs.[0].url (eq page.breadcrumbs.[0].urlType 'internal'))}}
          <a href="{{{relativize page.breadcrumbs.[0].url}}}" title="{{{page.breadcrumbs.[0].content}}}" aria-label="{{{page.breadcrumbs.[0].content}}}">{{{page.breadcrumbs.[0].content}}}</a>
        {{else}}
          {{{page.breadcrumbs.[0].content}}}
        {{/if}}
      </li>
    {{/if}}
  </ul>
</nav>
